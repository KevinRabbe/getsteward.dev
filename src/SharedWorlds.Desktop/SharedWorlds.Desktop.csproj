<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/SafeWorld.ico</ApplicationIcon>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyName>SharedWorlds.Desktop</AssemblyName>
    <RootNamespace>SharedWorlds.Desktop</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="SharedWorlds.Core.Worlds" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Steamworks.NET" />
