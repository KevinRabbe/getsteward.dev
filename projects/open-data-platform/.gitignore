__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Runtime data: never commit real source payloads.
data/staging/*
!data/staging/.gitkeep
data/archive/content/sha256/*
!data/archive/content/sha256/.gitkeep
data/archive/snapshots/*
!data/archive/snapshots/.gitkeep
data/events/*
!data/events/.gitkeep
data/normalized/*
!data/normalized/.gitkeep
data/products/*
!data/products/.gitkeep
data/releases/*
!data/releases/.gitkeep
data/changes/*
!data/changes/.gitkeep
data/distributions/*
!data/distributions/.gitkeep
data/logs/*
!data/logs/.gitkeep
data/metrics/*
!data/metrics/.gitkeep
