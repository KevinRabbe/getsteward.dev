<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyName>SharedWorlds.Desktop</AssemblyName>
    <RootNamespace>SharedWorlds.Desktop</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="SharedWorlds.Core.Worlds" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Steamworks.NET" />
    <PackageReference Include="Facepunch.Steamworks.Dll" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SharedWorlds.Core/SharedWorlds.Core.csproj" />
    <ProjectReference Include="../SharedWorlds.Infrastructure/SharedWorlds.Infrastructure.csproj" />
    <ProjectReference Include="../SharedWorlds.GameAdapters/Factorio/SharedWorlds.GameAdapters.Factorio.csproj" />
    <ProjectReference Include="../SharedWorlds.GameAdapters/Palworld/SharedWorlds.GameAdapters.Palworld.csproj" />
    <ProjectReference Include="../SharedWorlds.GameAdapters/SevenDaysToDie/SharedWorlds.GameAdapters.SevenDaysToDie.csproj" />
    <ProjectReference Include="../SharedWorlds.GameAdapters/ProjectZomboid/SharedWorlds.GameAdapters.ProjectZomboid.csproj" />
    <ProjectReference Include="../SharedWorlds.GameAdapters/Terraria/SharedWorlds.GameAdapters.Terraria.csproj" />
    <ProjectReference Include="../SharedWorlds.GameAdapters/StardewValley/SharedWorlds.GameAdapters.StardewValley.csproj" />
    <ProjectReference Include="../SharedWorlds.GameAdapters/Necesse/SharedWorlds.GameAdapters.Necesse.csproj" />
    <ProjectReference Include="../SharedWorlds.GameAdapters/CoreKeeper/SharedWorlds.GameAdapters.CoreKeeper.csproj" />
  </ItemGroup>
</Project>
