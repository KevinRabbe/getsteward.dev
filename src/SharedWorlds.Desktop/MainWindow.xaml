<Window x:Class="SharedWorlds.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SharedWorlds.Desktop"
        Title="Steward"
        Width="1180"
        Height="760"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="24,18"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Steward"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Click World. Play."
                               Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WorldNavigationColumn" Width="330" />
                <ColumnDefinition x:Name="WorldDetailsColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="GamesLibraryPanel"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="{StaticResource AppBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,28,32,32">
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,24,0">
                                <TextBlock Text="Games"
                                           FontSize="30"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Choose a game to see its managed Worlds."
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="13" />
                            </StackPanel>
                            <Button x:Name="OpenImportButton"
                                    Grid.Column="1"
                                    Content="{x:Static local:DesktopText.Import}"
                                    AutomationProperties.HelpText="Import a detected game World into Steward on this PC."
                                    Padding="12,6"
                                    MinHeight="32"
                                    Margin="0,0,8,0" />
                            <Button x:Name="RefreshButton"
                                    Grid.Column="2"
                                    Content="{x:Static local:DesktopText.Refresh}"
                                    AutomationProperties.HelpText="Refresh installed games, Worlds, and current Steward state."
                                    Padding="12,6"
                                    MinHeight="32" />
                        </Grid>

                        <ListBox x:Name="GameLibraryList"
                                 AutomationProperties.Name="Games Library"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Width" Value="250" />
                                    <Setter Property="MinHeight" Value="126" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,14,14" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding GameName}" />
                                    <Setter Property="AutomationProperties.HelpText" Value="{Binding Summary}" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource StewardFocusVisualStyle}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="GameTileBorder"
                                                        Background="{StaticResource PanelBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        Padding="18">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="GameTileBorder"
                                                                Property="Background"
                                                                Value="{StaticResource PanelAltBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="GameTileBorder"
                                                                Property="Background"
                                                                Value="#252C3B" />
                                                        <Setter TargetName="GameTileBorder"
                                                                Property="BorderBrush"
                                                                Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="56"
                                                Height="56"
                                                Background="{StaticResource PanelAltBrush}"
                                                CornerRadius="10"
                                                VerticalAlignment="Top">
                                            <Image Source="{Binding IconPath}"
                                                   Width="48"
                                                   Height="48"
                                                   Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameName}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Summary}"
                                                       Margin="0,7,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="WorldSidebar"
                    Grid.Column="0"
                    Visibility="Collapsed"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="2,0,2,14">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BackToGamesButton"
                                    DockPanel.Dock="Left"
                                    Content="← Games"
                                    AutomationProperties.HelpText="Return to the Games Library."
                                    Padding="10,5"
                                    Margin="0,0,8,0" />
                            <Button x:Name="RefreshGameButton"
                                    DockPanel.Dock="Right"
                                    Content="{x:Static local:DesktopText.Refresh}"
                                    AutomationProperties.HelpText="Refresh managed Worlds and current Steward state."
                                    Padding="10,5" />
                        </DockPanel>
                        <TextBlock x:Name="SelectedGameNameText"
                                   Margin="0,14,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Worlds"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                    </StackPanel>

                    <ListBox x:Name="WorldList"
                             Grid.Row="1"
                             AutomationProperties.Name="Worlds"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding Subtitle}" />
                                <Setter Property="FocusVisualStyle" Value="{StaticResource StewardFocusVisualStyle}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="14">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background"
                                                            Value="{StaticResource PanelAltBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background"
                                                            Value="#252C3B" />
                                                    <Setter TargetName="ItemBorder"
                                                            Property="BorderBrush"
                                                            Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Expander Grid.Row="2"
                              Header="Device settings"
                              Foreground="{StaticResource TextBrush}"
                              Margin="2,14,2,0">
                        <Border Margin="0,8,0,0"
                                Padding="12"
                                Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <CheckBox x:Name="AllowHostingCheckBox"
                                          Content="Allow this device to host"
                                          AutomationProperties.HelpText="Allow Steward to use this device for temporary World hosting when the selected game supports it." />
                                <TextBlock x:Name="HostingPreferenceText"
                                           Margin="22,6,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="Hosting is disabled on this device." />
                            </StackPanel>
                        </Border>
                    </Expander>
                </Grid>
            </Border>

            <ScrollViewer x:Name="WorldDetailsScroll"
                          Grid.Column="1"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,32,36,32"
                            MaxWidth="760"
                            HorizontalAlignment="Left">
                    <Button x:Name="BackToWorldsButton"
                            Content="{x:Static local:DesktopText.BackToWorlds}"
                            Visibility="Collapsed"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,18"
                            Padding="12,6" />

                    <TextBlock x:Name="EmptyStateText"
                               Text="Select a World."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="18" />

                    <StackPanel x:Name="WorldDetailsPanel" Visibility="Collapsed">
                        <TextBlock x:Name="WorldNameText"
                                   FontSize="32"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="GameText"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="15" />

                        <WrapPanel Margin="0,20,0,0">
                            <Border Background="{StaticResource PanelAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,6"
                                    Margin="0,0,8,8">
                                <TextBlock x:Name="SharingText" FontSize="13" />
                            </Border>
                            <Border Background="{StaticResource PanelAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,6"
                                    Margin="0,0,8,8">
                                <TextBlock x:Name="VersionText" FontSize="13" />
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="Play"
                                   Margin="0,26,0,12"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <WrapPanel>
                            <Button x:Name="ContinueButton"
                                    Content="{x:Static local:DesktopText.StartWorld}"
                                    AutomationProperties.HelpText="Start a writable local session for this World."
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,10,10" />
                            <Button x:Name="HostButton"
                                    Content="{x:Static local:DesktopText.HostWorld}"
                                    AutomationProperties.HelpText="Start temporary multiplayer hosting for this World when supported."
                                    Margin="0,0,10,10" />
                            <Button x:Name="StopHostingButton"
                                    Content="{x:Static local:DesktopText.StopAndSave}"
                                    AutomationProperties.HelpText="Safely stop the hosted session and save the updated World."
                                    Visibility="Collapsed"
                                    Margin="0,0,10,10"
                                    Click="StopHostingButton_Click" />
                            <Button x:Name="ShareButton"
                                    Content="{x:Static local:DesktopText.ShareWorld}"
                                    AutomationProperties.HelpText="Persistently share this Steward-managed World with other Steam identities."
                                    Margin="0,0,10,10" />
                        </WrapPanel>

                        <TextBlock Text="World settings"
                                   Margin="0,26,0,12"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20">
                            <StackPanel>
                                <CheckBox x:Name="KeepExactGameVersionCheckBox"
                                          Content="Keep this World on this exact game version"
                                          AutomationProperties.HelpText="Require Steward to verify this World against its recorded exact game environment before writable play."
                                          IsEnabled="{Binding IsEnabled, ElementName=WorldList}"
                                          Click="KeepExactGameVersionCheckBox_Click" />
                                <TextBlock x:Name="GameVersionPolicyText"
                                           Margin="22,6,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Environment readiness"
                                   Margin="0,26,0,12"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20">
                            <StackPanel>
                                <TextBlock x:Name="EnvironmentReadinessText"
                                           AutomationProperties.LiveSetting="Polite"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Text="Not checked yet." />
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="VerifyEnvironmentButton"
                                            Content="{x:Static local:DesktopText.VerifyEnvironment}"
                                            AutomationProperties.HelpText="Check whether this device exactly matches the World environment required for writable play."
                                            Margin="0,0,10,10"
                                            Click="VerifyEnvironmentButton_Click" />
                                    <Button x:Name="RepairEnvironmentButton"
                                            Content="{x:Static local:DesktopText.Repair}"
                                            AutomationProperties.HelpText="Repair the local game environment toward the exact World requirement when the adapter supports repair."
                                            IsEnabled="False"
                                            Margin="0,0,10,10"
                                            Click="RepairEnvironmentButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Expander Header="Technical details"
                                  Foreground="{StaticResource TextBrush}"
                                  Margin="0,26,0,0">
                            <Border Margin="0,10,0,0"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="World ID"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,0,24,10" />
                                    <TextBlock x:Name="WorldIdText"
                                               Grid.Row="0"
                                               Grid.Column="1"
                                               Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="Environment"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,0,24,10" />
                                    <TextBlock x:Name="EnvironmentRevisionText"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="State"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,0,24,0" />
                                    <TextBlock x:Name="StateRevisionText"
                                               Grid.Row="2"
                                               Grid.Column="1" />
                                </Grid>
                            </Border>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Padding="20,10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{StaticResource PanelBrush}">
            <TextBlock x:Name="StatusText"
                       AutomationProperties.LiveSetting="Polite"
                       Text="Ready"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12" />
        </Border>
    </Grid>
</Window>