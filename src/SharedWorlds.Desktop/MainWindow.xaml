<Window x:Class="SharedWorlds.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SharedWorlds.Desktop"
        Title="Safe World"
        Width="1280"
        Height="820"
        MinWidth="760"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Product shell -->
        <Border Grid.Row="0"
                Padding="28,14"
                Background="{StaticResource ShellSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="42"
                            Height="42"
                            CornerRadius="12"
                            Background="{StaticResource BrandGradientBrush}">
                        <TextBlock Text="SW"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Safe World"
                                   FontSize="21"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static local:DesktopText.Tagline}"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WorldNavigationColumn" Width="390" />
                <ColumnDefinition x:Name="WorldDetailsColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Games home -->
            <Border x:Name="GamesLibraryPanel"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="{StaticResource AppBackgroundBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="40,36,40,44"
                                MaxWidth="1160"
                                HorizontalAlignment="Center">
                        <Grid Margin="0,0,0,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,24,0">
                                <TextBlock Text="{x:Static local:DesktopText.Games}"
                                           FontSize="34"
                                           FontWeight="Bold" />
                                <TextBlock Text="{x:Static local:DesktopText.GamesLibraryDescription}"
                                           Margin="0,7,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="14" />
                            </StackPanel>
                            <Button x:Name="OpenImportButton"
                                    Grid.Column="1"
                                    Content="{x:Static local:DesktopText.Import}"
                                    AutomationProperties.HelpText="Import a detected game World into Safe World on this PC."
                                    Margin="0,0,8,0" />
                            <Button x:Name="RefreshButton"
                                    Grid.Column="2"
                                    Content="{x:Static local:DesktopText.Refresh}"
                                    AutomationProperties.HelpText="Refresh installed games, Worlds, and current Safe World state." />
                        </Grid>

                        <ListBox x:Name="GameLibraryList"
                                 AutomationProperties.Name="{x:Static local:DesktopText.GamesLibrary}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Width" Value="350" />
                                    <Setter Property="MinHeight" Value="142" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,18,18" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding GameName}" />
                                    <Setter Property="AutomationProperties.HelpText" Value="{Binding Summary}" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource StewardFocusVisualStyle}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="GameTileBorder"
                                                        Background="{StaticResource PanelBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="16"
                                                        Padding="20">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="GameTileBorder"
                                                                Property="Background"
                                                                Value="{StaticResource PanelAltBrush}" />
                                                        <Setter TargetName="GameTileBorder"
                                                                Property="BorderBrush"
                                                                Value="#35465F" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="GameTileBorder"
                                                                Property="Background"
                                                                Value="{StaticResource AccentSoftBrush}" />
                                                        <Setter TargetName="GameTileBorder"
                                                                Property="BorderBrush"
                                                                Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="72"
                                                Height="72"
                                                Background="{StaticResource PanelAltBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Image Source="{Binding IconPath}"
                                                   Width="60"
                                                   Height="60"
                                                   Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Margin="14,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameName}"
                                                       FontSize="19"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Summary}"
                                                       Margin="0,6,0,0"
                                                       FontSize="13"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Open game →"
                                                       Margin="0,12,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Selected-game navigation. SafeWorldGamesHome re-composes this from these authoritative controls. -->
            <Border x:Name="WorldSidebar"
                    Grid.Column="0"
                    Visibility="Collapsed"
                    Background="{StaticResource ShellSurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="2,0,2,16">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="BackToGamesButton"
                                    DockPanel.Dock="Left"
                                    Content="{x:Static local:DesktopText.BackToGames}"
                                    AutomationProperties.HelpText="Return to the Games Library."
                                    Style="{StaticResource GhostButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button x:Name="RefreshGameButton"
                                    DockPanel.Dock="Right"
                                    Content="{x:Static local:DesktopText.Refresh}"
                                    AutomationProperties.HelpText="Refresh Worlds and current Safe World state."
                                    Style="{StaticResource GhostButtonStyle}" />
                        </DockPanel>
                        <TextBlock x:Name="SelectedGameNameText"
                                   Margin="0,16,0,0"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Static local:DesktopText.Worlds}"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                    </StackPanel>

                    <ListBox x:Name="WorldList"
                             Grid.Row="1"
                             AutomationProperties.Name="{x:Static local:DesktopText.Worlds}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding Subtitle}" />
                                <Setter Property="FocusVisualStyle" Value="{StaticResource StewardFocusVisualStyle}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="11"
                                                    Padding="13,12">
                                                <Grid>
                                                    <Border x:Name="AccentRail"
                                                            Width="3"
                                                            Margin="-13,-4,0,-4"
                                                            HorizontalAlignment="Left"
                                                            Background="{StaticResource AccentBrush}"
                                                            CornerRadius="2"
                                                            Visibility="Collapsed" />
                                                    <ContentPresenter Margin="3,0,0,0" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background"
                                                            Value="{StaticResource PanelAltBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background"
                                                            Value="{StaticResource AccentSoftBrush}" />
                                                    <Setter TargetName="ItemBorder"
                                                            Property="BorderBrush"
                                                            Value="#30436D" />
                                                    <Setter TargetName="AccentRail"
                                                            Property="Visibility"
                                                            Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Expander Grid.Row="2"
                              Header="{x:Static local:DesktopText.DeviceSettings}"
                              Foreground="{StaticResource TextBrush}"
                              Margin="2,14,2,0">
                        <Border Margin="0,8,0,0"
                                Padding="14"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <CheckBox x:Name="AllowHostingCheckBox"
                                          Content="{x:Static local:DesktopText.AllowDeviceHosting}"
                                          AutomationProperties.HelpText="Allow Safe World to use this device for temporary World hosting when the selected game supports it." />
                                <TextBlock x:Name="HostingPreferenceText"
                                           Margin="28,7,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="{x:Static local:DesktopText.HostingDisabledOnDevice}" />
                            </StackPanel>
                        </Border>
                    </Expander>
                </Grid>
            </Border>

            <!-- World workspace -->
            <ScrollViewer x:Name="WorldDetailsScroll"
                          Grid.Column="1"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="46,38,46,48"
                            MaxWidth="900"
                            HorizontalAlignment="Left">
                    <Button x:Name="BackToWorldsButton"
                            Content="{x:Static local:DesktopText.BackToWorlds}"
                            Visibility="Collapsed"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,22"
                            Style="{StaticResource GhostButtonStyle}" />

                    <TextBlock x:Name="EmptyStateText"
                               Text="{x:Static local:DesktopText.SelectWorld}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="18" />

                    <StackPanel x:Name="WorldDetailsPanel" Visibility="Collapsed">
                        <Border Width="48"
                                Height="4"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Left"
                                Background="{StaticResource BrandGradientBrush}"
                                CornerRadius="2" />
                        <TextBlock x:Name="WorldNameText"
                                   FontSize="38"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="GameText"
                                   Margin="0,7,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="15" />

                        <WrapPanel Margin="0,18,0,0">
                            <Border Background="{StaticResource AccentSoftBrush}"
                                    BorderBrush="#344777"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,5"
                                    Margin="0,0,8,8">
                                <TextBlock x:Name="SharingText"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border Background="{StaticResource PanelAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,5"
                                    Margin="0,0,8,8">
                                <TextBlock x:Name="VersionText"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Border>
                        </WrapPanel>

                        <Border Margin="0,22,0,0"
                                Padding="22"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{x:Static local:DesktopText.Play}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Start, host, or share this World."
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <WrapPanel Margin="0,16,0,0">
                                    <Button x:Name="ContinueButton"
                                            Content="{x:Static local:DesktopText.StartWorld}"
                                            AutomationProperties.HelpText="Continue this World on this PC."
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,0,10,10" />
                                    <Button x:Name="HostButton"
                                            Content="{x:Static local:DesktopText.HostWorld}"
                                            AutomationProperties.HelpText="Start temporary multiplayer hosting for this World when supported."
                                            Margin="0,0,10,10" />
                                    <Button x:Name="StopHostingButton"
                                            Content="{x:Static local:DesktopText.StopAndSave}"
                                            AutomationProperties.HelpText="Safely stop the hosted session and save the updated World."
                                            Visibility="Collapsed"
                                            Margin="0,0,10,10"
                                            Click="StopHostingButton_Click" />
                                    <Button x:Name="ShareButton"
                                            Content="{x:Static local:DesktopText.ShareWorld}"
                                            AutomationProperties.HelpText="Share this Safe World-managed World with other Steam identities."
                                            Style="{StaticResource GhostButtonStyle}"
                                            Margin="0,0,10,10" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Padding="20"
                                    Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static local:DesktopText.WorldSettings}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Version behavior for this World."
                                               Margin="0,5,0,16"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <CheckBox x:Name="KeepExactGameVersionCheckBox"
                                              Content="{x:Static local:DesktopText.KeepExactGameVersion}"
                                              AutomationProperties.HelpText="Require Safe World to verify this World against its recorded exact game environment before writable play."
                                              IsEnabled="{Binding IsEnabled, ElementName=WorldList}"
                                              Click="KeepExactGameVersionCheckBox_Click" />
                                    <TextBlock x:Name="GameVersionPolicyText"
                                               Margin="28,8,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="20"
                                    Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static local:DesktopText.EnvironmentReadiness}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="EnvironmentReadinessText"
                                               AutomationProperties.LiveSetting="Polite"
                                               Margin="0,7,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Text="{x:Static local:DesktopText.NotCheckedYet}" />
                                    <WrapPanel Margin="0,16,0,0">
                                        <Button x:Name="VerifyEnvironmentButton"
                                                Content="{x:Static local:DesktopText.VerifyEnvironment}"
                                                AutomationProperties.HelpText="Check whether this device exactly matches the World environment required for writable play."
                                                Margin="0,0,10,10"
                                                Click="VerifyEnvironmentButton_Click" />
                                        <Button x:Name="RepairEnvironmentButton"
                                                Content="{x:Static local:DesktopText.Repair}"
                                                AutomationProperties.HelpText="Repair the local game environment toward the exact World requirement when the adapter supports repair."
                                                IsEnabled="False"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Margin="0,0,10,10"
                                                Click="RepairEnvironmentButton_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Expander Header="{x:Static local:DesktopText.TechnicalDetails}"
                                  Foreground="{StaticResource MutedTextBrush}"
                                  Margin="0,22,0,0">
                            <Border Margin="0,10,0,0"
                                    Padding="20"
                                    Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{x:Static local:DesktopText.WorldIdLabel}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,0,24,10" />
                                    <TextBlock x:Name="WorldIdText"
                                               Grid.Row="0"
                                               Grid.Column="1"
                                               Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="{x:Static local:DesktopText.EnvironmentLabel}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,0,24,10" />
                                    <TextBlock x:Name="EnvironmentRevisionText"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="{x:Static local:DesktopText.StateLabel}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,0,24,0" />
                                    <TextBlock x:Name="StateRevisionText"
                                               Grid.Row="2"
                                               Grid.Column="1" />
                                </Grid>
                            </Border>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border x:Name="StatusBar"
                Grid.Row="2"
                Padding="22,10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{StaticResource ShellSurfaceBrush}">
            <TextBlock x:Name="StatusText"
                       AutomationProperties.LiveSetting="Polite"
                       Text="{x:Static local:DesktopText.Ready}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12" />
        </Border>
    </Grid>
</Window>
